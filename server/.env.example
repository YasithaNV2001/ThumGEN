# Copy to .env and fill in. Never commit .env.

NODE_ENV=development
PORT=3000

# MongoDB Atlas connection string (free M0 cluster works)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/thumgen

# Long random string, e.g. output of:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Which AI generates the images:
#   cloudflare = FREE daily allowance, no credit card (FLUX.1 schnell)
#   gemini     = paid per image, best quality and text rendering
IMAGE_PROVIDER=cloudflare

# Cloudflare Workers AI (when IMAGE_PROVIDER=cloudflare)
# Account ID: Cloudflare dashboard > Workers & Pages (right sidebar)
# API token: My Profile > API Tokens > Create Token > "Workers AI" template
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Google Gemini (when IMAGE_PROVIDER=gemini): https://aistudio.google.com/apikey, billing required
GEMINI_API_KEY=
# Use gemini-3-pro-image for top quality at a higher cost
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# From the Cloudinary dashboard: cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=

# Allowed frontend origins, comma-separated
CLIENT_URL=http://localhost:5173

# Free generations per new account
FREE_CREDITS=5

# Generations for one-click guest accounts ("Try as guest")
GUEST_CREDITS=2

# Max generations per UTC day across ALL users: keeps you inside the free allowance / caps the bill
DAILY_GENERATION_LIMIT=50
