# Copy to .env and fill in. Never commit .env.

NODE_ENV=development
PORT=3000

# MongoDB Atlas connection string (free M0 cluster works)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/thumgen

# Long random string, e.g. output of:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Google AI Studio key: https://aistudio.google.com/apikey (image generation needs billing enabled)
GEMINI_API_KEY=
# Cheaper alternative: gemini-2.5-flash-image
GEMINI_IMAGE_MODEL=gemini-3-pro-image-preview

# From the Cloudinary dashboard: cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=

# Allowed frontend origins, comma-separated
CLIENT_URL=http://localhost:5173

# Free generations per new account
FREE_CREDITS=5
